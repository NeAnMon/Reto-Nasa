# AstroVital Environment Configuration (COPY TO .env)
# WARNING: Replace all demonstration secrets and credentials before deploying to production!
# El arranque registra avisos "CONFIGURACIÓN INSEGURA" si SECRET_KEY es la de demo, si SEED_DEMO_DATA=true
# o si DEMO_EXPOSE_RECOVERY_TOKEN=true.

APP_NAME=AstroVital
# Solo informativo (se muestra en /admin/system-status). No activa ningún comportamiento de depuración.
APP_ENV=development
APP_VERSION=1.0.0
# Genere una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-demo-secret-key-in-production-9f8e7d6c5b4a3210
SESSION_EXPIRE_HOURS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Database Configuration (SQLite for dev/demo, PostgreSQL for production)
DATABASE_URL=sqlite:///./astrovital.db
# Example PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://astrovital_user:strong_password@localhost:5432/astrovital_prod

# Demo Mode & Seed Settings
ENABLE_DEMO_SIMULATOR=true
# true = crea las cuentas demo de abajo (contraseñas públicas). false en producción.
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@astrovital.demo
DEMO_ADMIN_PASSWORD=AstroAdmin!2026
DEMO_LEADER_EMAIL=leader@astrovital.demo
DEMO_LEADER_PASSWORD=AstroLeader!2026
DEMO_ASTRONAUT1_EMAIL=elena.rostova@astrovital.demo
DEMO_ASTRONAUT1_PASSWORD=AstroCrew!2026
DEMO_ASTRONAUT2_EMAIL=marcus.vance@astrovital.demo
DEMO_ASTRONAUT2_PASSWORD=AstroCrew!2026
DEMO_ASTRONAUT3_EMAIL=kenji.takahashi@astrovital.demo
DEMO_ASTRONAUT3_PASSWORD=AstroCrew!2026
DEMO_ANALOG_PASSWORD=AstroCrew!2026

# SOLO DEMO LOCAL AISLADA: true hace que /auth/password-recovery/request devuelva el token de recuperación
# en la respuesta (cualquiera podría restablecer la contraseña de cualquier cuenta). Por defecto false.
DEMO_EXPOSE_RECOVERY_TOKEN=false

# Optional AI Provider Integration (Leave empty to use built-in deterministic Rule & Template Engine)
AI_PROVIDER_ENABLED=false
AI_API_KEY=
AI_MODEL_NAME=
